{
  "expo": {
    "name": "Renter",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "renter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.directhousing.xybiz4",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos of your home to your listing",
        "NSCameraUsageDescription": "Snap photos of your home for tenants"
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBHNCwzbEmRACZ0ztnn9GJI_cctBKmKNO4"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00A87D"
      },
      "package": "com.emergent.directhousing.xybiz4",
      "permissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.READ_EXTERNAL_STORAGE"],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBHNCwzbEmRACZ0ztnn9GJI_cctBKmKNO4"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCFCF9"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos of your home to your listing"
        }
      ],
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
